--========================================
-- AI OUTPUT
--========================================

local CHAT_PREFIX = "[AI]: "
local CHAT_CHUNK_LENGTH = 170 -- Leaves room for the prefix under Roblox chat limits.
local CHAT_CHUNK_DELAY = 1.05 -- Avoid sending long answers as a rapid burst.

local function SplitChatReply(text)
    local chunks = {}
    local remaining = Trim(text)

    while #remaining > CHAT_CHUNK_LENGTH do
        local candidate = remaining:sub(1, CHAT_CHUNK_LENGTH)
        local splitAt = candidate:match(".*()%s")

        if splitAt and splitAt > 1 then
            Append(chunks, Trim(remaining:sub(1, splitAt - 1)))
            remaining = Trim(remaining:sub(splitAt + 1))
        else
            -- Extremely long single words are split as a last resort.
            Append(chunks, candidate)
            remaining = Trim(remaining:sub(CHAT_CHUNK_LENGTH + 1))
        end
    end

    if remaining ~= "" then
        Append(chunks, remaining)
    end

    return chunks
end

local function SendAI(answer)
    local clean = Trim(answer)
    clean = clean:gsub("[%c]", " ")
    clean = clean:gsub("%s+", " ")

    if clean == "" then
        clean = "I didn't get a clear answer."
    end

    local chunks = SplitChatReply(clean)
    local channel = GetChatChannel()
    local allSent = true

    for index, chunk in ipairs(chunks) do
        local output = CHAT_PREFIX .. chunk
        local sent = false

        if channel then
            local sendOK, sendError = pcall(function()
                channel:SendAsync(output)
            end)
            sent = sendOK

            if not sendOK then
                warn("[AI] SendAsync failed: " .. tostring(sendError):sub(1, 160))
                local displayed = pcall(function()
                    channel:DisplaySystemMessage(output)
                end)
                if not displayed then
                    warn("[AI] Could not display reply chunk: " .. output)
                end
            end
        else
            warn("[AI] No usable chat channel. Reply: " .. output)
        end

        if not sent then
            allSent = false
        end

        if index < #chunks then
            task.wait(CHAT_CHUNK_DELAY)
            channel = GetChatChannel()
        end
    end

    return allSent
end

