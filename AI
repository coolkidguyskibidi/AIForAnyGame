local function CreateFlyTouchControls()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then
        return
    end

    if flyGui then
        flyGui:Destroy()
        flyGui = nil
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "AI_FlyControls"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 50
    gui.Parent = playerGui
    flyGui = gui

    local function makeHoldButton(name, label, yOffset, setHeld)
        local button = Instance.new("TextButton")
        button.Name = name
        button.AnchorPoint = Vector2.new(1, 1)
        button.Position = UDim2.new(1, -24, 1, yOffset)
        button.Size = UDim2.fromOffset(64, 56)
        button.BackgroundColor3 = Color3.fromRGB(35, 42, 58)
        button.BackgroundTransparency = 0.12
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        button.Text = label
        button.TextScaled = true
        button.Font = Enum.Font.GothamBold
        button.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = button

        button.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                setHeld(true)
            end
        end)
        button.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                setHeld(false)
            end
        end)
        return button
    end

    makeHoldButton("FlyUp", "UP", -154, function(value)
        flyAscendHeld = value
    end)
    makeHoldButton("FlyDown", "DOWN", -88, function(value)
        flyDescendHeld = value
    end)
end

StopFly = function()
    if not flyActive and not flyVelocity and not flyGyro then
        return
    end

    flyActive = false
    flyAscendHeld = false
    flyDescendHeld = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    if flyInputBeganConnection then
        flyInputBeganConnection:Disconnect()
        flyInputBeganConnection = nil
    end
    if flyInputEndedConnection then
        flyInputEndedConnection:Disconnect()
        flyInputEndedConnection = nil
    end

    if flyVelocity then
        pcall(function() flyVelocity:Destroy() end)
        flyVelocity = nil
    end
    if flyGyro then
        pcall(function() flyGyro:Destroy() end)
        flyGyro = nil
    end
    if flyGui then
        pcall(function() flyGui:Destroy() end)
        flyGui = nil
    end

    local _, humanoid = GetCharacterParts(LocalPlayer)
    if humanoid then
        humanoid.AutoRotate = true
    end
end

local function StartFly()
    if flyActive then
        StopFly()
        SendAI("Fly off.")
        return
    end

    StopMovement()
    StopSpin()
    StopCustomAnimation()

    local _, humanoid, root = GetCharacterParts(LocalPlayer)
    if not humanoid or not root or humanoid.Health <= 0 then
        SendAI("I can't fly right now; your character isn't ready.")
        return
    end

    flyActive = true
    flyAscendHeld = false
    flyDescendHeld = false
    humanoid.AutoRotate = false

    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "AI_FlyVelocity"
    velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    velocity.P = 15000
    velocity.Velocity = Vector3.zero
    velocity.Parent = root
    flyVelocity = velocity

    local gyro = Instance.new("BodyGyro")
    gyro.Name = "AI_FlyGyro"
    gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    gyro.P = 18000
    gyro.D = 900
    gyro.CFrame = root.CFrame
    gyro.Parent = root
    flyGyro = gyro

    CreateFlyTouchControls()

    flyInputBeganConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then
            return
        end
        if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
            flyAscendHeld = true
        elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.Q then
            flyDescendHeld = true
        end
    end)

    flyInputEndedConnection = UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
            flyAscendHeld = false
        elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.Q then
            flyDescendHeld = false
        end
    end)

    flyConnection = RunService.Heartbeat:Connect(function()
        if not flyActive then
            return
        end

        local _, currentHumanoid, currentRoot = GetCharacterParts(LocalPlayer)
        if not currentHumanoid or not currentRoot or currentHumanoid.Health <= 0
            or not flyVelocity or not flyGyro then
            StopFly()
            return
        end

        -- Humanoid.MoveDirection reads the normal keyboard or mobile thumbstick.
        local horizontal = currentHumanoid.MoveDirection * FLY_SPEED
        local vertical = 0
        if flyAscendHeld and not flyDescendHeld then
            vertical = FLY_SPEED
        elseif flyDescendHeld and not flyAscendHeld then
            vertical = -FLY_SPEED
        end
        flyVelocity.Velocity = Vector3.new(horizontal.X, vertical, horizontal.Z)

        local camera = Workspace.CurrentCamera
        local facing = camera and camera.CFrame.LookVector or currentRoot.CFrame.LookVector
        local flatFacing = Vector3.new(facing.X, 0, facing.Z)
        if flatFacing.Magnitude > 0.01 then
            flyGyro.CFrame = CFrame.lookAt(currentRoot.Position, currentRoot.Position + flatFacing.Unit)
        end
    end)

    SendAI("Fly on. Use your movement stick to move, hold UP/DOWN on the screen to change height, or use Space/E and Ctrl/Q.")
end

local function StartMovement(mode)
    if movementActive and movementMode == mode then
        return
    end

    StopFly()
    StopCustomAnimation()
    StopSpin()
    StopMovement()

    movementActive = true
    movementMode = mode
    movementToken = movementToken + 1
    local myToken = movementToken

    TakeCameraControl()
    BindMovementController()

    task.spawn(function()
        while movementActive and movementToken == myToken do
            local _, humanoid, root = GetCharacterParts(LocalPlayer)

            if not humanoid or not root or humanoid.Health <= 0 then
                activeWorldDirection = Vector3.zero
                task.wait(0.5)
            else
                -- Small pauses are intentional, but movement resumes automatically.
                local pauseChance = (mode == "explore") and 0.16 or 0.10
                if math.random() < pauseChance then
                    activeWorldDirection = Vector3.zero
                    task.wait(math.random(4, 10) / 10)
                end

                if not movementActive or movementToken ~= myToken then
                    break
                end

                local direction = ChooseMovementDirection()

                if direction.Magnitude < 0.01 then
                    activeWorldDirection = Vector3.zero
                    task.wait(0.45)
                else
                    activeWorldDirection = direction
                    local duration = math.random(18, 34) / 10
                    local endTime = os.clock() + duration

                    while os.clock() < endTime
                        and movementActive
                        and movementToken == myToken
                    do
                        local _, currentHumanoid, currentRoot = GetCharacterParts(LocalPlayer)
                        if not currentHumanoid or not currentRoot or currentHumanoid.Health <= 0 then
                            break
                        end

                        if not IsDirectionClear(activeWorldDirection, currentRoot) then
                            break
                        end

                        task.wait(0.12)
                    end

                    activeWorldDirection = Vector3.zero
                    task.wait(0.15)
                end
            end
        end

        if movementToken == myToken then
            activeWorldDirection = Vector3.zero
        end
    end)
end

local function StartAutopilot()
    StartMovement("autopilot")
    SendAI("Autopilot on.")
end

local function StartExploring()
    currentGoal = "Explore different nearby objects and areas."
    StartMovement("explore")
    SendAI("Let's explore!")
end

