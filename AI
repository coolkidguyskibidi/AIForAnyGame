local function HasAny(text, words)
    for _, word in ipairs(words) do
        if text:find(word, 1, true) then
            return true
        end
    end
    return false
end

local function GetCharacterSnapshot(character, player, question)
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    local rig = humanoid and tostring(humanoid.RigType) or "unknown rig"
    local label = player and (player.DisplayName .. " (Username: " .. player.Name .. ")") or character.Name
    local details = { "Character: " .. label, "Rig: " .. rig }

    local wantsAvatarDetails = HasAny(question, {
        "avatar", "character", "outfit", "wearing", "skin", "accessor", "how do i look", "how does"
    })
    local wantsHealth = HasAny(question, { "health", " hp", "hp?", "hit points" })
    local wantsPosition = HasAny(question, {
        "coordinate", "position", "where am i", "where is my", "location", "coordinates"
    })
    local wantsTools = HasAny(question, {
        "tool", "tools", "inventory", "backpack", "equipped", "holding", "carrying", "equipment"
    })

    if wantsAvatarDetails then
        local visibleItems = {}
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Accessory") then
                Append(visibleItems, child.Name)
            elseif child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("BodyColors") then
                Append(visibleItems, child.ClassName)
            end
            if #visibleItems >= 8 then
                break
            end
        end
        if #visibleItems > 0 then
            Append(details, "Visible avatar items: " .. table.concat(visibleItems, ", "))
        else
            Append(details, "Visible avatar items: none identified")
        end
    end

    if wantsTools then
        local toolNames = {}
        local equippedNames = {}

        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") then
                Append(toolNames, child.Name)
                Append(equippedNames, child.Name)
            end
        end

        if player then
            local backpack = player:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, child in ipairs(backpack:GetChildren()) do
                    if child:IsA("Tool") then
                        Append(toolNames, child.Name)
                    end
                end
            end
        end

        Append(details, "Equipped tools: " .. (#equippedNames > 0 and table.concat(equippedNames, ", ") or "none"))
        Append(details, "Tools in inventory: " .. (#toolNames > 0 and table.concat(toolNames, ", ") or "none detected"))
    end

    -- Health and coordinates are added only when the player explicitly asks for them.
    if wantsHealth and humanoid then
        Append(details, string.format("Health: %.0f/%.0f", humanoid.Health, humanoid.MaxHealth))
    end
    if wantsPosition and root then
        Append(details, string.format("Position: %.1f, %.1f, %.1f", root.Position.X, root.Position.Y, root.Position.Z))
    end

    return table.concat(details, "\n")
end

local function BuildAwarenessContext(question, speaker)
    -- Camera awareness is only valid for the local player. Never attach the
    -- owner's camera view to another whitelisted speaker's question.
    if speaker ~= LocalPlayer then
        return nil
    end

    local q = SafeLower(question)
    local asksSelfAvatar = HasAny(q, {
        "my avatar", "my character", "my outfit", "my skin", "what am i wearing", "how do i look",
        "my health", "my hp", "my position", "where am i", "my coordinates", "my location",
        "my tools", "my inventory", "my backpack", "what am i holding", "what am i carrying"
    })
    local asksTools = HasAny(q, {
        "my tool", "my tools", "what tool", "which tool", "what am i holding", "what am i carrying",
        "my inventory", "my backpack", "what do i have equipped", "what is equipped", "what's equipped"
    })
    local asksAvatar = HasAny(q, { "avatar", "character", "outfit", "wearing", "accessor", "skin" })
    local asksPlayer = HasAny(q, {
        "player", "who is", "who's", "who am i looking at", "who am i facing",
        "that person", "that guy", "that girl"
    })
    local asksLook = HasAny(q, {
        "looking at", "look at", "what do i see", "what am i seeing", "what is this",
        "what's this", "what is that", "what's that", "in front of me", "the thing i'm looking",
        "what tool is this", "what tool is that", "identify this object", "identify this item"
    })
    local asksObject = HasAny(q, {
        "object", "item", "npc", "building", "block", "map", "area", "environment", "game world"
    }) or asksLook
    local asksGame = HasAny(q, { "this game", "the map", "this map", "this area", "game world", "environment" })
    local wantsPosition = HasAny(q, { "coordinate", "position", "where am i", "location" })
    local wantsHealth = HasAny(q, { "health", " hp", "hp?", "hit points" })

    if not (asksSelfAvatar or asksAvatar or asksTools or asksPlayer or asksObject or asksGame or wantsPosition or wantsHealth) then
        return nil
    end

    local context = {}
    if asksGame then
        Append(context, "Experience PlaceId: " .. tostring(game.PlaceId))
    end

    local characterToDescribe = nil
    local playerToDescribe = nil
    if asksSelfAvatar or asksTools or ((wantsPosition or wantsHealth) and not asksPlayer) then
        characterToDescribe = LocalPlayer.Character
        playerToDescribe = LocalPlayer
    end

    if asksObject or asksPlayer or asksGame or (asksAvatar and not asksSelfAvatar) then
        local camera = Workspace.CurrentCamera
        if camera then
            local viewport = camera.ViewportSize
            local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = LocalPlayer.Character and { LocalPlayer.Character } or {}
            params.IgnoreWater = true

            local result = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
            if result and result.Instance then
                local hit = result.Instance
                local model = hit:FindFirstAncestorOfClass("Model")
                local hitHumanoid = model and model:FindFirstChildOfClass("Humanoid")
                local hitPlayer = model and Players:GetPlayerFromCharacter(model)

                if hitHumanoid and (asksPlayer or asksAvatar or asksLook) then
                    characterToDescribe = model
                    playerToDescribe = hitPlayer
                    Append(context, "Object under the center of the player's screen: character " .. (hitPlayer and hitPlayer.DisplayName or model.Name))
                elseif asksObject then
                    local objectName = model and model.Name or hit.Name
                    Append(context, "Object under the center of the player's screen: " .. objectName
                        .. "; hit part: " .. hit.Name
                        .. "; class: " .. hit.ClassName
                        .. "; material: " .. tostring(hit.Material))
                    if hitHumanoid then
                        characterToDescribe = model
                        playerToDescribe = hitPlayer
                    end
                end
            elseif asksObject or asksLook then
                Append(context, "The center of the player's screen is not currently pointing at a detectable object.")
            end
        end
    end

    if characterToDescribe then
        local snapshot = GetCharacterSnapshot(characterToDescribe, playerToDescribe, q)
        if snapshot then
            Append(context, snapshot)
        end
    elseif asksSelfAvatar then
        Append(context, "The local player's character is not currently loaded.")
    end

    if #context == 0 then
        return nil
    end
    return table.concat(context, "\n")
end

--========================================
-- NORMAL CONVERSATION
--========================================

local function AskAI(question, speaker)
    local awarenessContext = BuildAwarenessContext(question, speaker)
    local messages = {
        {
            role = "system",
            content = ([[You are [AI], a friendly Roblox game assistant.
Answer the player's actual question naturally and directly.
DEFAULT TO SHORT, NATURAL CHAT REPLIES: usually one sentence, and at most two short sentences.
Do not give long explanations, lists, or paragraphs for simple questions.
ONLY give a longer answer when the player explicitly asks for details, asks you to explain something, or the topic genuinely needs multiple steps to be understood.
When a longer answer is useful, organize it clearly and include only relevant details.
Do not randomly mention commands, movement, autopilot, exploration, spin, dance, backflip, float, or orbit.
Do not volunteer coordinates, health, player statistics, or a list of nearby objects. Only discuss those details when the player explicitly asks.
Use live game context only when it directly answers the player's question. Never dump the context, describe unrelated objects, or guess details that are not provided.
Only discuss game controls when the player asks about them.
Do not repeat the question or list unrelated information.
If you do not know something, say so clearly.]]
            .. (awarenessContext
                and "\n\nLIVE GAME CONTEXT (use only if relevant; do not volunteer unrelated stats):\n" .. awarenessContext
                or ""))
        },
        {
            role = "user",
            content = GetPlayerName(speaker) .. ": " .. question
        }
    }

    local answerParts = {}
    local maxContinuations = 3

    for attempt = 1, maxContinuations + 1 do
        local part, finishReason = GroqRequest(messages, 450)
        Append(answerParts, part)
        Append(messages, { role = "assistant", content = part })

        if finishReason ~= "length" or attempt > maxContinuations then
            break
        end

        Append(messages, {
            role = "user",
            content = "Continue exactly where your previous answer stopped. Do not repeat any earlier text. Finish the answer."
        })
    end

    return table.concat(answerParts, " ")
end

--========================================
-- QUESTION QUEUE
--========================================

local function StartQuestionWorker()
    if queueRunning then
        return
    end

    queueRunning = true

    task.spawn(function()
        while #requestQueue > 0 do
            local item = table.remove(requestQueue, 1)
            local success, result = pcall(AskAI, item.question, item.speaker)

            if success then
                SendAI(result)
            else
                local problem = tostring(result)
                warn("[AI] Groq request failed: " .. problem)
                if problem:find("API key", 1, true) then
                    SendAI("My Groq key is not configured.")
                elseif problem:find("HTTP", 1, true) then
                    SendAI("Groq request failed. Check the API key, quota, or model response.")
                elseif problem:find("HTTP request function", 1, true) then
                    SendAI("This executor does not support the HTTP request needed for Groq.")
                else
                    SendAI("My reply failed. Check the executor console for the error.")
                end
            end

            task.wait(0.1)
        end

        queueRunning = false

        if #requestQueue > 0 then
            StartQuestionWorker()
        end
    end)
end

local function QueueQuestion(question, speaker)
    if #requestQueue >= MAX_QUEUE then
        SendAI("My question queue is full. Try again in a moment.")
        return
    end

    Append(requestQueue, {
        question = question,
        speaker = speaker
    })

    StartQuestionWorker()
end

