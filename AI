local function TakeCameraControl()
    local camera = Workspace.CurrentCamera
    local _, humanoid = GetCharacterParts(LocalPlayer)

    if not camera then
        return
    end

    if not cameraSaved then
        savedCameraType = camera.CameraType
        savedCameraSubject = camera.CameraSubject
        savedAutoRotate = humanoid and humanoid.AutoRotate or nil
        cameraSaved = true
    end

    camera.CameraType = Enum.CameraType.Scriptable
    cameraReady = false
end

local function UpdateCamera(dt)
    local camera = Workspace.CurrentCamera
    local _, humanoid, root = GetCharacterParts(LocalPlayer)

    if not camera or not humanoid or not root then
        return
    end

    camera.CameraType = Enum.CameraType.Scriptable

    local forward = root.CFrame.LookVector
    local target = root.Position + Vector3.new(0, 2, 0)
    local cameraPosition = root.Position - forward * 11 + Vector3.new(0, 5, 0)
    local desired = CFrame.lookAt(cameraPosition, target)

    if not cameraReady then
        camera.CFrame = desired
        cameraReady = true
    else
        local alpha = 1 - math.exp(-math.max(dt, 0) * 9)
        camera.CFrame = camera.CFrame:Lerp(desired, alpha)
    end

    camera.Focus = CFrame.new(target)
end

local function RestoreCamera()
    local camera = Workspace.CurrentCamera
    local _, humanoid = GetCharacterParts(LocalPlayer)

    if camera and cameraSaved then
        if savedCameraType then
            camera.CameraType = savedCameraType
        else
            camera.CameraType = Enum.CameraType.Custom
        end

        if savedCameraSubject and savedCameraSubject.Parent then
            camera.CameraSubject = savedCameraSubject
        elseif humanoid then
            camera.CameraSubject = humanoid
        end
    end

    if humanoid and savedAutoRotate ~= nil then
        humanoid.AutoRotate = savedAutoRotate
    end

    cameraSaved = false
    savedCameraType = nil
    savedCameraSubject = nil
    savedAutoRotate = nil
    cameraReady = false
end

--========================================
-- MOVEMENT / RAYCAST HELPERS
--========================================

local function FlatUnit(vector)
    local flat = Vector3.new(vector.X, 0, vector.Z)
    if flat.Magnitude < 0.01 then
        return Vector3.zero
    end
    return flat.Unit
end

local function DirectionFromAngle(root, degrees)
    local forward = FlatUnit(root.CFrame.LookVector)
    local right = FlatUnit(root.CFrame.RightVector)
    local angle = math.rad(degrees)
    local direction = forward * math.cos(angle) + right * math.sin(angle)
    return FlatUnit(direction)
end

local function GetExcludedCharacters()
    local excluded = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            Append(excluded, player.Character)
        end
    end
    return excluded
end

local function GetRaycastParams(target)
    local excluded = GetExcludedCharacters()

    if target then
        local targetModel = target:FindFirstAncestorOfClass("Model")
        Append(excluded, targetModel or target)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = true
    return params
end

local function IsDirectionClear(direction, root, target)
    if direction.Magnitude < 0.01 then
        return false
    end

    local origin = root.Position + Vector3.new(0, 1.5, 0)
    local result = Workspace:Raycast(origin, direction * 7, GetRaycastParams(target))

    if result and result.Instance and result.Instance.CanCollide then
        return false
    end

    return true
end

--========================================
-- EXPLORATION SCANNER
--========================================

local function GetExploreTargets(root)
    local character = LocalPlayer.Character
    if not root or not character then
        return {}
    end

    -- GetPartBoundsInRadius requires OverlapParams, not RaycastParams.
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = GetExcludedCharacters()
    overlap.MaxParts = 120

    local ok, parts = pcall(function()
        return Workspace:GetPartBoundsInRadius(root.Position, 40, overlap)
    end)

    if not ok or type(parts) ~= "table" then
        warn("[AI] Explore scan failed: " .. tostring(parts))
        return {}
    end

    local targets = {}
    local seen = {}
    local ignored = {
        baseplate = true,
        terrain = true,
        part = true,
        meshpart = true,
        wedgepart = true,
        union = true
    }

    for _, part in ipairs(parts) do
        if part:IsA("BasePart") and part.CanQuery and part.Transparency < 1 then
            local model = part:FindFirstAncestorOfClass("Model")
            local targetObject = model or part
            local targetName = targetObject.Name
            local distance = (part.Position - root.Position).Magnitude
            local hasHumanoid = model and model:FindFirstChildOfClass("Humanoid")

            if not hasHumanoid
                and not ignored[SafeLower(targetName)]
                and not seen[targetObject]
                and distance >= 7
                and distance <= 38
            then
                seen[targetObject] = true
                Append(targets, {
                    part = part,
                    name = targetName,
                    distance = distance
                })
            end
        end
    end

    table.sort(targets, function(a, b)
        return a.distance < b.distance
    end)

    return targets
end

local function ChooseExploreDirection(root)
    local targets = GetExploreTargets(root)
    local tries = math.min(#targets, 10)

    for _ = 1, tries do
        local index = math.random(1, #targets)
        local target = table.remove(targets, index)
        local direction = FlatUnit(target.part.Position - root.Position)

        if direction.Magnitude > 0.01 and IsDirectionClear(direction, root, target.part) then
            print("[AI] Exploring toward: " .. tostring(target.name))
            return direction
        end
    end

    return nil
end

local function ChooseRandomDirection(root)
    local angles = {0, 35, -35, 65, -65, 100, -100, 145, -145, 180}

    for i = #angles, 2, -1 do
        local j = math.random(1, i)
        angles[i], angles[j] = angles[j], angles[i]
    end

    for _, angle in ipairs(angles) do
        local direction = DirectionFromAngle(root, angle)
        if IsDirectionClear(direction, root) then
            return direction
        end
    end

    return Vector3.zero
end

local function ChooseMovementDirection()
    local _, humanoid, root = GetCharacterParts(LocalPlayer)
    if not humanoid or not root or humanoid.Health <= 0 then
        return Vector3.zero
    end

    if movementMode == "explore" then
        local exploreDirection = ChooseExploreDirection(root)
        if exploreDirection then
            return exploreDirection
        end
    end

    return ChooseRandomDirection(root)
end

--========================================
-- MOVEMENT CONTROLLER
--========================================

local function BindMovementController()
    if movementBound then
        return
    end

    local bindOK, bindError = pcall(function()
        RunService:BindToRenderStep(
            MOVEMENT_BIND,
            Enum.RenderPriority.Camera.Value + 1,
            function(dt)
                local _, humanoid, root = GetCharacterParts(LocalPlayer)
                if not humanoid or not root or humanoid.Health <= 0 then
                    return
                end

                if movementActive or spinActive then
                    UpdateCamera(dt)
                end

                if movementActive and movementMode == "orbit" and not spinActive then
                    local targetPlayer = orbitTargetPlayer
                    local _, targetHumanoid, targetRoot = GetCharacterParts(targetPlayer)

                    if not targetPlayer or targetPlayer.Parent ~= Players
                        or not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
                        humanoid:Move(Vector3.zero, false)
                        if not orbitStopQueued then
                            orbitStopQueued = true
                            task.defer(function()
                                orbitStopQueued = false
                                if movementActive and movementMode == "orbit" then
                                    StopMovement()
                                    SendAI("Orbit stopped because the target is unavailable.")
                                end
                            end)
                        end
                    else
                        -- Do not walk toward the target. Reposition directly at the orbit
                        -- point every render frame, so target movement is followed instantly.
                        orbitAngle = (orbitAngle + math.rad(orbitSpeedDegrees) * math.max(dt, 0)) % (math.pi * 2)
                        local orbitOffset = Vector3.new(
                            math.cos(orbitAngle) * ORBIT_RADIUS,
                            orbitHeightOffset,
                            math.sin(orbitAngle) * ORBIT_RADIUS
                        )
                        local destination = targetRoot.Position + orbitOffset
                        local lookAtPosition = targetRoot.Position + Vector3.new(0, 1.5, 0)

                        humanoid.AutoRotate = false
                        humanoid:Move(Vector3.zero, false)
                        root.CFrame = CFrame.lookAt(destination, lookAtPosition)
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end
                elseif movementActive and not spinActive then
                    humanoid.AutoRotate = true
                    humanoid:Move(activeWorldDirection, false)
                else
                    humanoid:Move(Vector3.zero, false)
                end
            end
        )
    end)

    if bindOK then
        movementBound = true
    else
        warn("[AI] Could not bind movement controller: " .. tostring(bindError))
    end
end

local function CleanupController()
    if movementActive or spinActive then
        return
    end

    if movementBound then
        pcall(function()
            RunService:UnbindFromRenderStep(MOVEMENT_BIND)
        end)
        movementBound = false
    end

    local _, humanoid = GetCharacterParts(LocalPlayer)
    if humanoid then
        humanoid:Move(Vector3.zero, false)
    end

    RestoreCamera()
end

StopMovement = function()
    movementActive = false
    movementMode = "none"
    movementToken = movementToken + 1
    activeWorldDirection = Vector3.zero
    orbitTargetPlayer = nil

    local _, humanoid = GetCharacterParts(LocalPlayer)
    if humanoid then
        humanoid:Move(Vector3.zero, false)
        if not spinActive then
            humanoid.AutoRotate = true
        end
    end

    CleanupController()
end

StopSpin = function()
    if not spinActive then
        return
    end

    spinActive = false

    if spinConnection then
        spinConnection:Disconnect()
        spinConnection = nil
    end

    local _, humanoid = GetCharacterParts(LocalPlayer)
    if humanoid then
        humanoid.AutoRotate = true
    end

    CleanupController()
end

