local function RequestServerListPage(placeId, cursor)
    local url = "https://games.roblox.com/v1/games/" .. tostring(placeId)
        .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
    end

    local body = nil
    local requestError = nil

    if type(httpRequest) == "function" then
        local ok, response = pcall(function()
            return httpRequest({
                Url = url,
                Method = "GET",
                Headers = { ["Accept"] = "application/json" }
            })
        end)
        if ok and response then
            if type(response) == "string" then
                body = response
            elseif type(response) == "table" then
                local statusCode = tonumber(response.StatusCode or response.Status)
                if statusCode and (statusCode < 200 or statusCode >= 300) then
                    requestError = "Roblox server-list request returned HTTP " .. tostring(statusCode) .. "."
                else
                    body = response.Body or response.body
                end
            end
        elseif not ok then
            requestError = tostring(response)
        end
    end

    if (type(body) ~= "string" or body == "") then
        local ok, result = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and type(result) == "string" then
            body = result
        elseif not requestError then
            requestError = tostring(result)
        end
    end

    if type(body) ~= "string" or body == "" then
        return nil, requestError or "No HTTP response was available."
    end

    local decodeOK, decoded = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if not decodeOK or type(decoded) ~= "table" then
        return nil, "Roblox returned an unreadable server list."
    end

    return decoded
end

local function RejoinCurrentServer()
    if teleportPending then
        SendAI("A teleport is already in progress.")
        return
    end

    teleportPending = true
    local autoloadQueued, autoloadReason = QueueScriptAutoload()
    if autoloadQueued then
        SendAI("Rejoining this server. Script autoload is queued.")
    else
        warn("[AI] Autoload was not queued: " .. tostring(autoloadReason))
        SendAI("Rejoining this server. Autoload is not configured: " .. tostring(autoloadReason) .. ".")
    end
    task.delay(0.8, function()
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
        if not ok then
            teleportPending = false
            warn("[AI] Rejoin failed: " .. tostring(err))
            SendAI("Rejoin failed: " .. tostring(err))
        end
    end)
end

pcall(function()
    TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
        if player == LocalPlayer then
            teleportPending = false
            local reason = errorMessage or teleportResult or "Unknown teleport error"
            warn("[AI] Teleport initialization failed: " .. tostring(reason))
            SendAI("Teleport failed: " .. tostring(reason))
        end
    end)
end)

local function StartServerHop()
    if teleportPending then
        SendAI("A teleport is already in progress.")
        return
    end

    teleportPending = true
    SendAI("Searching for another public server...")

    task.spawn(function()
        local candidates = {}
        local cursor = nil
        local lastError = nil

        -- Check a few pages so a different server can still be found when the
        -- first page is mostly full or includes the current instance.
        for pageNumber = 1, 3 do
            local page, pageError = RequestServerListPage(game.PlaceId, cursor)
            if not page then
                lastError = pageError
                break
            end

            if type(page.data) == "table" then
                for _, server in ipairs(page.data) do
                    local serverId = server and server.id
                    local playing = tonumber(server and server.playing)
                    local maxPlayers = tonumber(server and server.maxPlayers)
                    if type(serverId) == "string"
                        and serverId ~= ""
                        and serverId ~= game.JobId
                        and playing and maxPlayers
                        and playing < maxPlayers then
                        Append(candidates, {
                            id = serverId,
                            playing = playing,
                            maxPlayers = maxPlayers
                        })
                    end
                end
            end

            cursor = page.nextPageCursor
            if type(cursor) ~= "string" or cursor == "" then
                break
            end
        end

        if #candidates == 0 then
            teleportPending = false
            if lastError then
                warn("[AI] Server hop lookup failed: " .. tostring(lastError))
                SendAI("I couldn't load the public server list. Check that HTTP requests are available, then try again.")
            else
                SendAI("I couldn't find another available public server for this place.")
            end
            return
        end

        -- Prefer less crowded servers, then choose randomly among the least
        -- crowded group to avoid repeatedly targeting the same full instances.
        table.sort(candidates, function(a, b)
            return (a.playing / a.maxPlayers) < (b.playing / b.maxPlayers)
        end)
        local topCount = math.min(12, #candidates)
        local target = candidates[math.random(1, topCount)]

        local autoloadQueued, autoloadReason = QueueScriptAutoload()
        if autoloadQueued then
            SendAI("Found another server. Script autoload is queued; joining now...")
        else
            warn("[AI] Autoload was not queued: " .. tostring(autoloadReason))
            SendAI("Found another server. Joining now, but autoload is not configured: " .. tostring(autoloadReason) .. ".")
        end
        task.wait(0.8)
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
        end)
        if not ok then
            teleportPending = false
            warn("[AI] Server hop failed: " .. tostring(err))
            SendAI("Server hop failed: " .. tostring(err))
        end
    end)
end

