local function StartCopiedChatQueueWorker()
    if copiedChatQueueRunning then
        return
    end

    copiedChatQueueRunning = true
    task.spawn(function()
        while copiedChatQueueHead <= copiedChatQueueTail do
            local outgoing = copiedChatQueue[copiedChatQueueHead]
            copiedChatQueue[copiedChatQueueHead] = nil
            copiedChatQueueHead = copiedChatQueueHead + 1

            local channel = GetChatChannel()
            if channel and outgoing then
                local sent, sendError = pcall(function()
                    channel:SendAsync(outgoing)
                end)
                if not sent then
                    warn("[AI] Could not relay copied chat: " .. tostring(sendError))
                end
            else
                warn("[AI] Cannot relay copied chat because no chat channel is available.")
            end

            task.wait(COPIED_CHAT_SEND_DELAY)
        end

        copiedChatQueue = {}
        copiedChatQueueHead = 1
        copiedChatQueueTail = 0
        copiedChatQueueRunning = false

        -- Recheck after releasing the worker flag in case new text arrived.
        if copiedChatQueueHead <= copiedChatQueueTail then
            StartCopiedChatQueueWorker()
        end
    end)
end

local function QueueCopiedChatAsOwner(speaker, clean)
    local prefix = "[" .. GetPlayerName(speaker) .. "]: "
    local maxBodyLength = math.max(40, COPIED_CHAT_MAX_MESSAGE_LENGTH - #prefix)
    local remaining = clean

    while #remaining > 0 do
        local piece
        if #remaining <= maxBodyLength then
            piece = remaining
            remaining = ""
        else
            local candidate = remaining:sub(1, maxBodyLength)
            local splitAt = candidate:match(".*()%s")
            if splitAt and splitAt > 1 then
                piece = Trim(remaining:sub(1, splitAt - 1))
                remaining = Trim(remaining:sub(splitAt + 1))
            else
                piece = candidate
                remaining = Trim(remaining:sub(maxBodyLength + 1))
            end
        end

        if piece ~= "" then
            if copiedChatQueueTail - copiedChatQueueHead + 1 >= COPIED_CHAT_MAX_QUEUE then
                warn("[AI] CopyChat relay queue is full; some incoming text was skipped.")
                return
            end
            copiedChatQueueTail = copiedChatQueueTail + 1
            copiedChatQueue[copiedChatQueueTail] = prefix .. piece
        end
    end

    StartCopiedChatQueueWorker()
end

local function HandleCopiedChatMessage(speaker, messageText)
    if not copiedChatTarget or speaker ~= copiedChatTarget or type(messageText) ~= "string" then
        return
    end
    local clean = Trim(messageText):gsub("[%c]", " "):gsub("%s+", " ")
    if clean == "" then
        return
    end

    -- TextChatService and legacy Chatted may report the same public message.
    local key = tostring(speaker.UserId) .. "|" .. clean
    local now = os.clock()
    if copiedChatSeen[key] and now - copiedChatSeen[key] < 1.25 then
        return
    end
    copiedChatSeen[key] = now
    for oldKey, seenAt in pairs(copiedChatSeen) do
        if now - seenAt > 8 then
            copiedChatSeen[oldKey] = nil
        end
    end

    -- Re-send through the owner's chat account, clearly attributing the source.
    QueueCopiedChatAsOwner(speaker, clean)
end

local function StartOrbit(query, requestedSpeed)
    local targetPlayer, reason = FindPlayerByNameOrDisplayName(query)
    if not targetPlayer then
        SendAI(reason)
        return
    end

    if targetPlayer == LocalPlayer then
        SendAI("I can't orbit around myself. Give me another player's name.")
        return
    end

    local _, targetHumanoid, targetRoot = GetCharacterParts(targetPlayer)
    if not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
        SendAI("That player's character isn't available right now.")
        return
    end

    local chosenSpeed = tonumber(requestedSpeed) or ORBIT_DEFAULT_SPEED
    if chosenSpeed <= 0 then
        SendAI("Orbit speed must be a positive number.")
        return
    end
    chosenSpeed = math.clamp(chosenSpeed, ORBIT_MIN_SPEED, ORBIT_MAX_SPEED)

    StopFly()
    StopCustomAnimation()
    StopSpin()
    StopMovement()

    local _, humanoid, root = GetCharacterParts(LocalPlayer)
    if not humanoid or not root or humanoid.Health <= 0 then
        SendAI("I can't start orbiting right now.")
        return
    end

    -- Keep the current side of the target, but snap to the orbit radius immediately.
    local initialOffset = Vector3.new(
        root.Position.X - targetRoot.Position.X,
        0,
        root.Position.Z - targetRoot.Position.Z
    )
    if initialOffset.Magnitude > 0.1 then
        orbitAngle = math.atan2(initialOffset.Z, initialOffset.X)
    else
        orbitAngle = 0
    end
    orbitHeightOffset = math.clamp(root.Position.Y - targetRoot.Position.Y, -4, 4)
    orbitSpeedDegrees = chosenSpeed
    orbitTargetPlayer = targetPlayer
    movementActive = true
    movementMode = "orbit"
    movementToken = movementToken + 1
    activeWorldDirection = Vector3.zero

    local firstOffset = Vector3.new(
        math.cos(orbitAngle) * ORBIT_RADIUS,
        orbitHeightOffset,
        math.sin(orbitAngle) * ORBIT_RADIUS
    )
    local firstPosition = targetRoot.Position + firstOffset
    root.CFrame = CFrame.lookAt(firstPosition, targetRoot.Position + Vector3.new(0, 1.5, 0))
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    TakeCameraControl()
    BindMovementController()
    humanoid.AutoRotate = false

    SendAI(string.format(
        "Orbiting around %s at %g degrees per second. Use /ai orbit off to stop.",
        GetPlayerName(targetPlayer), orbitSpeedDegrees
    ))
end

