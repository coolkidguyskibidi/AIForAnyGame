--========================================
-- GROQ REQUEST
--========================================

local function GroqRequest(messages, maxTokens)
    if type(httpRequest) ~= "function" then
        error("This executor does not provide an HTTP request function.")
    end

    if API_KEY == "" or API_KEY == "YOUR_NEW_GROQ_API_KEY_HERE" then
        error("Add your fresh Groq API key in the API_KEY line.")
    end

    local body = {
        model = MODEL,
        messages = messages,
        max_completion_tokens = maxTokens or 180,
        reasoning_effort = "low",
        stream = false
    }

    local requestData = {
        Url = API_URL,
        URL = API_URL,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Authorization"] = "Bearer " .. API_KEY
        },
        Body = HttpService:JSONEncode(body)
    }

    local requestOK, response = pcall(function()
        return httpRequest(requestData)
    end)

    if not requestOK then
        error("HTTP request failed: " .. tostring(response):sub(1, 140))
    end

    if type(response) ~= "table" then
        error("HTTP returned no response object.")
    end

    local responseBody = response.Body or response.body or response.ResponseBody
    local statusCode = tonumber(response.StatusCode or response.status_code or response.Status)

    if type(responseBody) ~= "string" or responseBody == "" then
        error("Groq returned an empty response body. HTTP status: " .. tostring(statusCode or "unknown"))
    end

    if statusCode and statusCode >= 400 then
        local shortBody = responseBody:gsub("[%c]", " "):sub(1, 180)
        error("Groq HTTP " .. tostring(statusCode) .. ": " .. shortBody)
    end

    local decodeOK, data = pcall(function()
        return HttpService:JSONDecode(responseBody)
    end)

    if not decodeOK or type(data) ~= "table" then
        error("Groq returned invalid JSON.")
    end

    if data.error then
        local message = data.error.message or data.error.code or "Unknown Groq API error"
        error("Groq API: " .. tostring(message):sub(1, 160))
    end

    local choice = data.choices and data.choices[1]
    local message = choice and choice.message
    local content = message and message.content
    local finishReason = choice and choice.finish_reason or nil

    if type(content) == "table" then
        local parts = {}
        for _, part in ipairs(content) do
            if type(part) == "table" and type(part.text) == "string" then
                Append(parts, part.text)
            end
        end
        content = table.concat(parts, " ")
    end

    content = Trim(content)
    if content == "" then
        error("Groq returned an empty answer.")
    end

    return content, finishReason
end

