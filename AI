local function BindHitDetection(character)
    if touchConnection then
        touchConnection:Disconnect()
        touchConnection = nil
    end

    local root = character:WaitForChild("HumanoidRootPart", 10)
    if not root then
        return
    end

    touchConnection = root.Touched:Connect(function(hit)
        -- Collision reactions belong to autopilot only. Orbit, exploration,
        -- spin, and manual movement must not trigger the "Ow! That hurts!" line.
        if not movementActive or movementMode ~= "autopilot"
            or not hit or not hit:IsA("BasePart") then
            return
        end

        if not hit.CanCollide or hit:IsDescendantOf(character) then
            return
        end

        local model = hit:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then
            return
        end

        if hit.Position.Y < root.Position.Y - 2.5 then
            return
        end

        if os.clock() - lastHitTime < HIT_COOLDOWN then
            return
        end

        lastHitTime = os.clock()
        SendAI("Ow! That hurts!")
    end)
end

