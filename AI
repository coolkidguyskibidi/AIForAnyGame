local function FindPlayerByNameOrDisplayName(query)
    local wanted = SafeLower(Trim(query))
    if wanted == "" then
        return nil, "Type a player's DisplayName or Username."
    end

    -- Username matches take priority because usernames are unique.
    for _, player in ipairs(Players:GetPlayers()) do
        if SafeLower(player.Name) == wanted then
            return player
        end
    end

    local displayMatches = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if SafeLower(player.DisplayName) == wanted then
            Append(displayMatches, player)
        end
    end

    if #displayMatches == 1 then
        return displayMatches[1]
    elseif #displayMatches > 1 then
        return nil, "More than one player has that DisplayName. Use their Username instead."
    end

    return nil, "I couldn't find that player. Check their DisplayName or Username."
end

local function AddWhitelistIdentifier(identifier)
    local clean = Trim(identifier)
    if clean == "" then
        return false, "Use /ai whitelist [Username or DisplayName]."
    end

    local player, reason = FindPlayerByNameOrDisplayName(clean)
    if not player and reason and reason:find("More than one player", 1, true) then
        return false, reason
    end

    if player then
        Whitelist["uid:" .. tostring(player.UserId)] = true
        Whitelist["name:" .. SafeLower(player.Name)] = true
        Whitelist["name:" .. SafeLower(player.DisplayName)] = true
        -- Keep plain-name keys for compatibility with older saved whitelist data.
        Whitelist[SafeLower(player.Name)] = true
        Whitelist[SafeLower(player.DisplayName)] = true
        SaveWhitelistData()
        return true, "Whitelisted " .. GetPlayerName(player) .. " (" .. player.Name .. ")."
    end

    local normalized = SafeLower(clean)
    Whitelist["name:" .. normalized] = true
    Whitelist[normalized] = true
    SaveWhitelistData()
    return true, "Saved " .. clean .. " to the whitelist. If that player is in this server, their Username or DisplayName will match."
end

local function RemoveWhitelistIdentifier(identifier)
    local clean = Trim(identifier)
    if clean == "" then
        return false, "Use /ai unwhitelist [Username or DisplayName]."
    end

    local player = FindPlayerByNameOrDisplayName(clean)
    if player then
        Whitelist["uid:" .. tostring(player.UserId)] = nil
        Whitelist["name:" .. SafeLower(player.Name)] = nil
        Whitelist["name:" .. SafeLower(player.DisplayName)] = nil
        Whitelist[SafeLower(player.Name)] = nil
        Whitelist[SafeLower(player.DisplayName)] = nil
        SaveWhitelistData()
        return true, "Removed " .. GetPlayerName(player) .. " (" .. player.Name .. ") from the whitelist."
    end

    local normalized = SafeLower(clean)
    Whitelist["name:" .. normalized] = nil
    Whitelist[normalized] = nil
    SaveWhitelistData()
    return true, "Removed " .. clean .. " from the whitelist."
end

local function IsWhitelisted(player)
    if not player then
        return false
    end

    local userIdKey = "uid:" .. tostring(player.UserId)
    local username = SafeLower(player.Name)
    local displayName = SafeLower(player.DisplayName)

    return Whitelist[userIdKey] == true
        or Whitelist["name:" .. username] == true
        or Whitelist["name:" .. displayName] == true
        or Whitelist[username] == true
        or Whitelist[displayName] == true
end

