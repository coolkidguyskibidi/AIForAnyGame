local function StopCustomAnimation()
    local oldTrack = activeAnimationTrack
    local oldAnimation = activeAnimationObject

    activeAnimationTrack = nil
    activeAnimationObject = nil
    activeAnimationName = nil

    if oldTrack then
        pcall(function()
            oldTrack:Stop(0.15)
        end)
        task.delay(0.25, function()
            pcall(function()
                oldTrack:Destroy()
            end)
        end)
    end

    if oldAnimation then
        pcall(function()
            oldAnimation:Destroy()
        end)
    end
end

local function PlayR15Animation(animationName, animationIds, shouldLoop)
    local _, humanoid = GetCharacterParts(LocalPlayer)
    if not humanoid or humanoid.Health <= 0 then
        SendAI("I can't play that animation right now.")
        return false
    end

    if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        SendAI("That animation requires an R15 avatar.")
        return false
    end

    -- Roblox must have replicated the Animator from the server for animation
    -- playback to replicate correctly to other clients.
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = humanoid:WaitForChild("Animator", 5)
    end

    if not animator or not animator:IsA("Animator") then
        SendAI("I couldn't find the character's Animator. Respawn and try again.")
        warn("[AI] Animator missing from the current Humanoid.")
        return false
    end

    local candidates = type(animationIds) == "table" and animationIds or { animationIds }
    StopCustomAnimation()

    local failures = {}

    for _, animationId in ipairs(candidates) do
        local animation = Instance.new("Animation")
        animation.AnimationId = animationId

        -- PreloadAsync can identify assets Roblox cannot fetch (for example,
        -- private, deleted, or otherwise unavailable animation assets).
        local fetchStatus = nil
        local preloadOK, preloadError = pcall(function()
            ContentProvider:PreloadAsync({ animation }, function(_, status)
                fetchStatus = status
            end)
        end)

        local statusIsSuccess = fetchStatus == nil
            or fetchStatus == Enum.AssetFetchStatus.Success

        if not preloadOK or not statusIsSuccess then
            Append(failures, animationId .. " (asset fetch failed: "
                .. tostring(fetchStatus or preloadError) .. ")")
            animation:Destroy()
        else
            local loadOK, trackOrError = pcall(function()
                return animator:LoadAnimation(animation)
            end)

            if not loadOK or not trackOrError then
                Append(failures, animationId .. " (load failed: " .. tostring(trackOrError) .. ")")
                animation:Destroy()
            else
                local track = trackOrError
                track.Priority = Enum.AnimationPriority.Action
                track.Looped = shouldLoop == true

                track.Stopped:Connect(function()
                    if activeAnimationTrack == track then
                        activeAnimationTrack = nil
                        activeAnimationName = nil
                        activeAnimationObject = nil
                        task.delay(0.15, function()
                            pcall(function()
                                track:Destroy()
                            end)
                            pcall(function()
                                animation:Destroy()
                            end)
                        end)
                    end
                end)

                local playOK, playError = pcall(function()
                    track:Play(0.12, 1, 1)
                end)

                if playOK then
                    activeAnimationTrack = track
                    activeAnimationObject = animation
                    activeAnimationName = animationName

                    SendAI(animationName .. (shouldLoop and " animation on." or " animation playing."))
                    print("[AI] Playing " .. animationName .. " using " .. animationId)
                    return true
                else
                    Append(failures, animationId .. " (play failed: " .. tostring(playError) .. ")")
                    pcall(function()
                        track:Stop(0)
                        track:Destroy()
                    end)
                    animation:Destroy()
                end
            end
        end
    end

    for _, failure in ipairs(failures) do
        warn("[AI] " .. animationName .. " candidate failed: " .. failure)
    end
    SendAI("I couldn't play the " .. animationName .. " animation. All supplied IDs failed to load; check asset permissions and Output.")
    return false
end

