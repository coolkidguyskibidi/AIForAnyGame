local function Trim(value)
    return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

-- Use direct array assignment instead of table.insert. Some client runtimes
-- expose a table.insert variant that requires an explicit numeric position,
-- which caused the SplitChatReply error shown in the Developer Console.
local function Append(array, value)
    array[#array + 1] = value
end

local function SafeLower(value)
    return tostring(value or ""):lower()
end

local function GetPlayerName(player)
