local function HandleOwnerCommand(args)
    local lower = SafeLower(args)

    if lower == "rejoin" then
        RejoinCurrentServer()
        return true
    elseif lower == "serverhop" then
        StartServerHop()
        return true
    elseif lower == "esp" then
        if espActive then
            StopESP()
            SendAI("ESP off.")
        else
            StartESP()
        end
        return true
    elseif lower == "esp on" then
        StartESP()
        return true
    elseif lower == "esp off" or lower == "esp stop" then
        if espActive then
            StopESP()
            SendAI("ESP off.")
        else
            SendAI("ESP is already off.")
        end
        return true
    elseif lower == "explode" or lower == "reset" then
        ResetOwnCharacter()
        return true
    elseif lower == "fly" then
        if flyActive then
            StopFly()
            SendAI("Fly off.")
        else
            StartFly()
        end
        return true
    elseif lower == "fly on" then
        if flyActive then
            SendAI("Fly is already on. Use /ai fly off to stop.")
        else
            StartFly()
        end
        return true
    elseif lower == "fly off" or lower == "fly stop" then
        StopFly()
        SendAI("Fly off.")
        return true
    elseif lower == "roast" then
        QueueFriendlyRoast()
        return true
    elseif lower == "sing" then
        QueueOriginalSong("")
        return true
    elseif lower:match("^sing%s+.+$") then
        local songName = Trim(args:match("^[Ss][Ii][Nn][Gg]%s+(.+)$"))
        QueueOriginalSong(songName)
        return true
    elseif lower == "copychat" then
        SendAI("Use /ai copychat [Username or DisplayName] to relay their public chat through your account using [DisplayName]: message, or /ai copychat off to stop.")
        return true
    elseif lower:match("^copychat%s+.+$") then
        local targetName = Trim(args:match("^[Cc][Oo][Pp][Yy][Cc][Hh][Aa][Tt]%s+(.+)$"))
        SetCopyChatTarget(targetName)
        return true
    elseif lower == "goto" then
        SendAI("Use /ai goto [Username or DisplayName].")
        return true
    elseif lower:match("^goto%s+.+$") then
        local targetName = Trim(args:match("^[Gg][Oo][Tt][Oo]%s+(.+)$"))
        GoToPlayer(targetName)
        return true
    elseif lower == "info" or lower == "commands" then
        SendCommandInfo()
        return true
    elseif lower == "fling" or lower:match("^fling%s+") then
        SendAI("I can't add a command that forcibly flings another player. I can help with a harmless orbit or a server-authorized admin feature in a game you own.")
        return true
    elseif lower:match("^speed%s+.+$") then
        local value = args:match("^[Ss][Pp][Ee][Ee][Dd]%s+(.+)$")
        SetWalkSpeedFromCommand(value)
        return true
    elseif lower == "speed" then
        SendAI("Use /ai speed [number], from 1 to 250.")
        return true
    elseif lower:match("^jump%s+.+$") then
        local value = args:match("^[Jj][Uu][Mm][Pp]%s+(.+)$")
        SetJumpPowerFromCommand(value)
        return true
    elseif lower == "jump" then
        SendAI("Use /ai jump [number], from 1 to 250.")
        return true
    elseif lower == "spin" or lower == "spin on" then
        StartSpin()
        return true
    elseif lower == "spin off" then
        StopSpin()
        SendAI("Spin stopped.")
        return true
    elseif lower == "orbit off" or lower == "orbit stop" then
        if movementMode == "orbit" then
            StopMovement()
            SendAI("Orbit stopped.")
        else
            SendAI("I'm not orbiting anyone right now.")
        end
        return true
    elseif lower == "orbit" then
        SendAI("Use /ai orbit [speed] [DisplayName or Username]. Example: /ai orbit 40 GettingSniper53")
        return true
    elseif lower:match("^orbit%s+.+$") then
        local orbitArguments = Trim(args:match("^[Oo][Rr][Bb][Ii][Tt]%s+(.+)$"))
        local firstWord, remainingWords = orbitArguments:match("^(%S+)%s+(.+)$")
        local parsedSpeed = firstWord and tonumber(firstWord) or nil

        if parsedSpeed then
            StartOrbit(Trim(remainingWords), parsedSpeed)
        else
            StartOrbit(orbitArguments, nil)
        end
        return true
    elseif lower == "backflip" or lower == "backflip on" then
        StartBackflip()
        return true
    elseif lower == "float" or lower == "float on" then
        StartFloat()
        return true
    elseif lower == "float off" or lower == "dance off" or lower == "animation off" then
        StopCustomAnimation()
        SendAI("Animation stopped.")
        return true
    elseif lower == "dance" or lower == "dance on" or lower == "dance 1" then
        StartDance(1)
        return true
    elseif lower == "dance 2" then
        StartDance(2)
        return true
    elseif lower == "autopilot" or lower == "autopilot on" then
        StartAutopilot()
        return true
    elseif lower == "autopilot off" then
        StopMovement()
        SendAI("Autopilot off.")
        return true
    elseif lower == "goal explore" or lower == "goal explore on"
        or lower == "explore" or lower == "explore on" then
        StartExploring()
        return true
    elseif lower == "goal explore off" or lower == "goal stop" or lower == "explore off" then
        if movementMode == "explore" then
            StopMovement()
            SendAI("Exploration stopped.")
        else
            SendAI("Exploration is already off.")
        end
        return true
    elseif lower == "stop" then
        StopFly()
        StopMovement()
        StopSpin()
        StopCustomAnimation()
        SendAI("Stopped.")
        return true
    elseif lower == "status" then
        SendAI(
            "Movement: " .. (movementActive and movementMode or "off")
            .. ". Spin: " .. (spinActive and "on" or "off")
            .. ". Fly: " .. (flyActive and "on" or "off")
            .. ". ESP: " .. (espActive and "on" or "off")
            .. ". Chat relay: " .. (copiedChatTarget and GetPlayerName(copiedChatTarget) or "off")
            .. ". Animation: " .. (activeAnimationName or "off") .. "."
        )
        return true
    end

    local newGoal = args:match("^[Gg][Oo][Aa][Ll]%s+(.+)$")
    if newGoal then
        currentGoal = Trim(newGoal)
        SendAI("Goal saved: " .. currentGoal)
        return true
    end

    local target = args:match("^[Ww][Hh][Ii][Tt][Ee][Ll][Ii][Ss][Tt]%s+(.+)$")
    if target then
        local added, message = AddWhitelistIdentifier(target)
        SendAI(message)
        return true
    elseif lower == "whitelist" then
        SendAI("Use /ai whitelist [Username or DisplayName].")
        return true
    end

    local removeTarget = args:match("^[Uu][Nn][Ww][Hh][Ii][Tt][Ee][Ll][Ii][Ss][Tt]%s+(.+)$")
    if removeTarget then
        local removed, message = RemoveWhitelistIdentifier(removeTarget)
        SendAI(message)
        return true
    elseif lower == "unwhitelist" then
        SendAI("Use /ai unwhitelist [Username or DisplayName].")
        return true
    end

    return false
end

local function IsRestrictedCommand(args)
    local lower = SafeLower(args)

    return lower == "rejoin" or lower == "serverhop"
        or lower == "esp" or lower == "esp on" or lower == "esp off" or lower == "esp stop"
        or lower == "explode" or lower == "reset"
        or lower == "fly" or lower == "fly on" or lower == "fly off" or lower == "fly stop"
        or lower == "roast" or lower == "sing" or lower:match("^sing%s+") ~= nil
        or lower == "copychat" or lower:match("^copychat%s+") ~= nil
        or lower == "goto" or lower:match("^goto%s+") ~= nil
        or lower == "spin" or lower == "spin on" or lower == "spin off"
        or lower == "dance" or lower == "dance on" or lower == "dance off"
        or lower == "dance 1" or lower == "dance 2"
        or lower == "backflip" or lower == "backflip on"
        or lower == "float" or lower == "float on" or lower == "float off"
        or lower == "orbit" or lower == "orbit off" or lower == "orbit stop"
        or lower:match("^orbit%s+") ~= nil
        or lower == "animation off" or lower == "stop" or lower == "status"
        or lower == "autopilot" or lower == "autopilot on" or lower == "autopilot off"
        or lower == "explore" or lower == "explore on" or lower == "explore off"
        or lower:match("^goal%s") ~= nil
        or lower == "speed" or lower:match("^speed%s+") ~= nil
        or lower == "jump" or lower:match("^jump%s+") ~= nil
        or lower == "fling" or lower:match("^fling%s+") ~= nil
        or lower == "whitelist" or lower:match("^whitelist%s") ~= nil
        or lower == "unwhitelist" or lower:match("^unwhitelist%s") ~= nil
end

--========================================
-- CHAT PROCESSING
--========================================

local function ProcessChat(speaker, rawText)
    if not speaker or type(rawText) ~= "string" then
        return
    end

    local fullText = Trim(rawText)
    if fullText == "" then
        return
    end

    local lowerText = SafeLower(fullText)
    if not lowerText:match("^/ai%s+") then
        return
    end

    -- Keep the original capitalization of the question.
    local args = Trim(fullText:sub(4))
    if args == "" then
        return
    end

    local isOwner = speaker.UserId == LocalPlayer.UserId
        and SafeLower(LocalPlayer.Name) == OWNER_USERNAME

    -- Authorize first. Whitelist lookup supports UserId, Username, DisplayName,
    -- and old username-only saved entries. Unapproved messages are ignored.
    if not isOwner and not IsWhitelisted(speaker) then
        return
    end

    -- Prevent double processing (SendingMessage + MessageReceived + Chatted).
    -- A short window avoids dropping a user's quick repeated /ai question.
    local key = tostring(speaker.UserId) .. "|" .. fullText
    local now = os.clock()
    if recentlyHandled[key] and (now - recentlyHandled[key]) < 0.9 then
        return
    end
    recentlyHandled[key] = now

    -- Keep this cache small.
    for oldKey, oldTime in pairs(recentlyHandled) do
        if now - oldTime > 10 then
            recentlyHandled[oldKey] = nil
        end
    end

    if isOwner then
        if HandleOwnerCommand(args) then
            return
        end
    else
        local lowerArgs = SafeLower(args)
        if lowerArgs == "info" or lowerArgs == "commands" then
            SendCommandInfo()
            return
        end

        if IsRestrictedCommand(args) then
            SendAI("Only the owner can control me.")
            return
        end
    end

    QueueQuestion(args, speaker)
end

-- Modern chat: catch the local player's message immediately when they send it.
pcall(function()
    TextChatService.SendingMessage:Connect(function(message)
        if message and type(message.Text) == "string" then
            local source = message.TextSource
            if not source or source.UserId == LocalPlayer.UserId then
                ProcessChat(LocalPlayer, message.Text)
            end
        end
    end)
end)

-- Modern chat: receive messages from other players and the server echo.
pcall(function()
    TextChatService.MessageReceived:Connect(function(message)
        if not message or not message.TextSource then
            return
        end

        local speaker = Players:GetPlayerByUserId(message.TextSource.UserId)
        if speaker then
            HandleCopiedChatMessage(speaker, message.Text)
            ProcessChat(speaker, message.Text)
        end
    end)
end)

-- Legacy chat / executor compatibility fallback. Duplicate events are filtered above.
local function HookPlayerChat(player)
    player.Chatted:Connect(function(message)
        HandleCopiedChatMessage(player, message)
        ProcessChat(player, message)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    HookPlayerChat(player)
end

Players.PlayerAdded:Connect(HookPlayerChat)

Players.PlayerRemoving:Connect(function(player)
    if copiedChatTarget == player then
        copiedChatTarget = nil
        copiedChatSeen = {}
        ClearCopiedChatQueue()
        local channel = GetChatChannel()
        if channel then
            pcall(function()
                channel:DisplaySystemMessage("[AI]: Chat relay stopped because that player left.")
            end)
        end
    end
end)

